{
  "$schema": "https://github.com/anomalyco/opencode/blob/main/design-tokens/schema.json",
  "meta": {
    "name": "GTM Arena",
    "version": "1.0.0",
    "description": "Design tokens del MVP 'Gestión de Torneos'. Fuente única de verdad para web (Tailwind/CSS variables) y apps híbridas (React Native). Unidades numéricas en px y colores en hex para portabilidad.",
    "platforms": ["web", "react-native"]
  },
  "color": {
    "brand": {
      "50": "#E9F7EF",
      "100": "#CBEED9",
      "200": "#9BDCB4",
      "300": "#5FC589",
      "400": "#2FAD66",
      "500": "#1A9351",
      "600": "#147842",
      "700": "#11603A",
      "800": "#0E4A2E",
      "900": "#0B3A26"
    },
    "amber": {
      "50": "#FFFBEB",
      "100": "#FEF3C7",
      "200": "#FDE68A",
      "300": "#FCD34D",
      "400": "#FBBF24",
      "500": "#F59E0B",
      "600": "#D97706",
      "700": "#B45309"
    },
    "night": {
      "50": "#F0F6F2",
      "100": "#DCEBE1",
      "200": "#B7D3C2",
      "300": "#8CB49D",
      "400": "#5C9077",
      "500": "#3A7058",
      "600": "#27513F",
      "700": "#1B3A2C",
      "800": "#12281E",
      "900": "#0B1F16"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F6F8F7",
      "100": "#EDF1EF",
      "200": "#DCE3DF",
      "300": "#C2CCC6",
      "400": "#94A39B",
      "500": "#6B7A72",
      "600": "#525F58",
      "700": "#3F4A44",
      "800": "#2A322E",
      "900": "#161C19"
    },
    "status": {
      "success": "#1A9351",
      "success-soft": "#E9F7EF",
      "danger": "#DC2626",
      "danger-soft": "#FEF2F2",
      "warning": "#D97706",
      "warning-soft": "#FEF3C7",
      "info": "#2563EB",
      "info-soft": "#EFF6FF",
      "live": "#E11D48"
    },
    "semantic": {
      "background": "#FFFFFF",
      "foreground": "#161C19",
      "card": "#FFFFFF",
      "surface-muted": "#F6F8F7",
      "border": "#E3E8E5",
      "divider": "#EDF1EF"
    }
  },
  "spacing": {
    "0": 0,
    "px": 1,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96,
    "28": 112,
    "32": 128
  },
  "typography": {
    "fontFamily": {
      "display": ["Barlow Condensed", "Arial Narrow", "sans-serif"],
      "body": ["Archivo", "Segoe UI", "sans-serif"]
    },
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "5xl": 48,
      "6xl": 60
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "lineHeight": {
      "tight": 1.1,
      "normal": 1.5,
      "relaxed": 1.6
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.05em",
      "wider": "0.1em",
      "widest": "0.18em"
    }
  },
  "radius": {
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 16,
    "2xl": 20,
    "3xl": 28,
    "full": 9999
  },
  "shadow": {
    "card": "0 1px 2px rgba(11, 31, 22, 0.06), 0 1px 3px rgba(11, 31, 22, 0.08)",
    "elevated": "0 8px 24px rgba(11, 31, 22, 0.12)",
    "glow": "0 0 0 1px rgba(26, 147, 81, 0.12), 0 8px 32px rgba(26, 147, 81, 0.25)"
  },
  "motion": {
    "durationFast": 120,
    "duration": 200,
    "durationSlow": 350,
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)"
  }
}
